# Copy to .env.worker on each worker VPS.

# When this Compose project runs on the same Docker host as the master, both
# projects join the external orabbit-control-plane network and use service DNS.
ORABBIT_MASTER_GRPC_ADDR=orabbit-master:9102
# For a worker on another host, use a private VPN/DNS address or the worker-local
# end of a trusted tunnel instead. Public endpoints also require gRPC TLS.
ORABBIT_GRPC_INSECURE=true
# For TLS with a private CA, mount the CA file and set:
# ORABBIT_TLS_CA_FILE=/run/orabbit-tls/ca.crt
# ORABBIT_TLS_SERVER_NAME=master.example.com
# Must exactly match the value on the master.
ORABBIT_WORKER_AUTH_TOKEN=<CHANGE_ME_DIFFERENT_LONG_RANDOM_TOKEN>

# Unique per worker, for example:
# ORABBIT_WORKER_ID=worker-1
ORABBIT_WORKER_ID=<WORKER_ID>

# Address this worker advertises to the master.
ORABBIT_WORKER_ADVERTISE_ADDR=<WORKER_PUBLIC_IP>

ORABBIT_WORKER_POLL=2s
ORABBIT_LOG_LEVEL=INFO
ORABBIT_LOG_FORMAT=json
AWS_EC2_METADATA_DISABLED=true

ORABBIT_DEFAULT_S3_ENDPOINT=
ORABBIT_DEFAULT_S3_ACCESS_KEY_ID=minioadmin
ORABBIT_DEFAULT_S3_SECRET_ACCESS_KEY=minioadmin
ORABBIT_DEFAULT_S3_REGION=us-east-1
ORABBIT_S3_FORCE_PATH_STYLE=true

# Copy to .env.master on the master VPS.

ORABBIT_DB_PATH=/var/lib/orabbit/master.sqlite
# 0.0.0.0 is the address *inside* the container; exposure is decided by the
# published port below. Remote HTTP requires the bearer token below and a
# TLS-terminating proxy. For a native (non-Docker) master use 127.0.0.1:9100.
ORABBIT_HTTP_ADDR=0.0.0.0:9100
# The container must listen on its shared Docker network. The base Compose file
# does not publish this port to the host.
ORABBIT_GRPC_ADDR=0.0.0.0:9102
# gRPC uses TLS. Workers authenticate with certificates the master issues
# itself at enrollment (its worker CA is created automatically and stored
# encrypted), so only the server certificate/key are needed. Mount and uncomment:
ORABBIT_GRPC_INSECURE=false
# ORABBIT_TLS_CERT_FILE=/run/orabbit-tls/tls.crt
# ORABBIT_TLS_KEY_FILE=/run/orabbit-tls/tls.key
# Lifetime of worker identity certificates (workers renew at 2/3 of it).
# ORABBIT_WORKER_CERT_TTL=24h

# Required if the HTTP API is exposed beyond localhost.
# Export the same value on your Mac before running orabbit-client.
# Generate with: openssl rand -hex 32
ORABBIT_HTTP_AUTH_TOKEN=<CHANGE_ME_LONG_RANDOM_TOKEN>

# Optional. Enables the remote operations API (SSH servers, Docker,
# deployments) with its own token, which must differ from the API token.
# Leave unset to keep remote operations disabled.
# ORABBIT_REMOTE_OPS_AUTH_TOKEN=<CHANGE_ME_THIRD_LONG_RANDOM_TOKEN>

# Required for this non-loopback gRPC listener. Copy the exact same random
# value to every worker's ORABBIT_WORKER_AUTH_TOKEN.
# Generate with: openssl rand -hex 32
ORABBIT_WORKER_AUTH_TOKEN=<CHANGE_ME_DIFFERENT_LONG_RANDOM_TOKEN>

# Required: the master refuses to start without it.
# Generate once with: openssl rand -base64 32
# Keep it stable; changing it makes encrypted stored secrets unreadable.
ORABBIT_MASTER_KEY=<CHANGE_ME_BASE64_32_BYTE_KEY>

ORABBIT_LOG_LEVEL=INFO
ORABBIT_LOG_FORMAT=json
ORABBIT_MAX_ACTIVE_RUNS=16
ORABBIT_MAX_ACTIVE_TASKS=64
ORABBIT_CATALOG_WORK_LIMIT=2
ORABBIT_UPLOAD_CAPACITY_LIMIT=8
ORABBIT_UPLOAD_CAPACITY_LEASE_TTL=2m
# Host port for the HTTP API. Bind it to a private interface or put it behind
# the TLS proxy; do not expose it directly to the internet.
ORABBIT_HTTP_PUBLISHED_PORT=9100
# Used only with docker-compose.master.grpc-publish.yml. Keep the default
# loopback bind for a tunnel; a non-loopback bind also requires gRPC TLS.
# ORABBIT_GRPC_PUBLISH_ADDR=127.0.0.1
# ORABBIT_GRPC_PUBLISHED_PORT=9102
AWS_EC2_METADATA_DISABLED=true

# Optional fallback S3 target. Use a dedicated, least-privilege access key,
# never MinIO root credentials. Leave empty to require per-connection creds.
ORABBIT_DEFAULT_S3_ENDPOINT=
ORABBIT_DEFAULT_S3_ACCESS_KEY_ID=
ORABBIT_DEFAULT_S3_SECRET_ACCESS_KEY=
ORABBIT_DEFAULT_S3_REGION=us-east-1
ORABBIT_S3_FORCE_PATH_STYLE=true

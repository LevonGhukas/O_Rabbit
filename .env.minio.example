# Copy to .env.minio on the MinIO VPS.

# MinIO no longer publishes images; these are built from upstream source by
# docker/minio/Dockerfile. Pin exact tags, never latest.
MINIO_IMAGE=levonghukas/minio:RELEASE.2025-10-15T17-29-55Z
MINIO_MC_IMAGE=levonghukas/mc:RELEASE.2025-08-13T08-35-41Z

# Change both values before exposing MinIO.
MINIO_ROOT_USER=<CHANGE_ME_MINIO_USER>
MINIO_ROOT_PASSWORD=<CHANGE_ME_MINIO_PASSWORD>

ORABBIT_S3_BUCKET=bucket1
MINIO_API_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001

# Optional when using the console through the public IP.
# MINIO_BROWSER_REDIRECT_URL=http://<MINIO_PUBLIC_IP>:9001

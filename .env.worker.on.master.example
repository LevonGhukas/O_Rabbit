# Copy to .env.worker.on.master on the master VPS if running a worker on the master node.

ORABBIT_MASTER_GRPC_ADDR=orabbit-master:9102
ORABBIT_GRPC_INSECURE=true
ORABBIT_WORKER_AUTH_TOKEN=<CHANGE_ME_DIFFERENT_LONG_RANDOM_TOKEN>

# Optional. Leave empty to auto-generate/use default behavior if supported.
ORABBIT_WORKER_ID=

# Public or private address workers should advertise.
ORABBIT_WORKER_ADVERTISE_ADDR=<MASTER_PUBLIC_IP>

ORABBIT_WORKER_POLL=2s
ORABBIT_LOG_LEVEL=INFO
ORABBIT_LOG_FORMAT=json
AWS_EC2_METADATA_DISABLED=true
